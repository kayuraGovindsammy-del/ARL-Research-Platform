# Authoritative environment configuration for the ARL platform.
# Copy to `.env.local` for local overrides (never commit secrets).

# ---------------------------------------------------------------------------
# ARL REST API — the exam lab API, documented at
# ${ARL_API_PROTOCOL}://${ARL_API_ADDRESS}:${ARL_API_PORT}/docs
# Override any value in `.env.local` (git-ignored) when working against a
# different deployment; nothing here is read by the code directly.
# ---------------------------------------------------------------------------
ARL_API_ADDRESS=wmc.ms.wits.ac.za
ARL_API_PORT=8080
# http | https
ARL_API_PROTOCOL=http
# Self-signed certificates are the norm on the lab LAN.
ARL_API_TLS_VERIFY=false
# The exam API is reached over the campus network, so allow for WAN latency.
ARL_API_TIMEOUT_MS=15000
# Endpoint paths (the /v1 contract exposed by the simulator).
ARL_API_PATH_TARGETS=/v1/targets
ARL_API_PATH_ALERT_LIMITS=/v1/alert-limits
ARL_API_PATH_RESEARCHER=/v1/researchers
ARL_API_PATH_VERIFY=/v1/researchers/verify

# Researcher on whose behalf this console issues commands. The services
# reject commands from unknown or defunct researchers.
ARL_RESEARCHER_CODE=arl-as3
ARL_RESEARCHER_NAME=Person A

# ---------------------------------------------------------------------------
# MQTT broker (telemetry ingestion + command publishing)
# ---------------------------------------------------------------------------
MQTT_BROKER_ADDRESS=wmc.ms.wits.ac.za
MQTT_BROKER_PORT=1883
# The exam broker is authenticated; leave blank for an anonymous local broker.
MQTT_BROKER_USER=student
MQTT_BROKER_PASSWORD=arl-exam
# Separator-stable, protocol is mqtt (or mqtts when the broker presents TLS).
MQTT_BROKER_PROTOCOL=mqtt
MQTT_TOPIC_PREFIX=arl

# ---------------------------------------------------------------------------
# Prisma / SQLite
# ---------------------------------------------------------------------------
# SQLite is a single-writer store; pinning the pool to one connection removes
# intra-process lock contention between the ingestion batches and the read
# routes (see lib/prisma.ts for the WAL / busy_timeout pragmas).
DATABASE_URL="file:./dev.db?connection_limit=1"
