// Astro-Research Laboratory platform data model.
// SQLite does not support native enums, so bounded value sets are stored as
// strings and validated in the application layer (lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Raw or derived telemetry sample ingested from the MQTT broker.
/// `service` is one of RTA | MHE | OPG | LWM, `payload` holds a JSON string.
model Telemetry {
  id        String   @id @default(uuid())
  service   String
  topic     String
  payload   String
  timestamp DateTime @default(now())

  @@index([service, timestamp])
  @@index([topic, timestamp])
  @@index([timestamp])
}

/// Operational alert raised by ingestion rules or explicit payload flags.
/// `status` is one of ACTIVE | ACKNOWLEDGED | RESOLVED.
///
/// The annunciator contract stores the whole decision context, not just a
/// sentence: who raised it and when, who acknowledged/resolved it and when,
/// and the cause (rule + entity + measured value against its limit) so a
/// researcher arriving later can decide what to do without replaying the log.
model Alert {
  id             String    @id @default(uuid())
  service        String
  alertType      String
  message        String
  status         String    @default("ACTIVE")
  timestamp      DateTime  @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?
  /// Human-readable cause: rule, entity and the value that breached the limit.
  cause          String?
  /// info | warning | critical
  severity       String?
  /// Dish / room / crew / array / `global`.
  entity         String?
  value          Float?
  limitValue     Float?
  unit           String?
  /// JSON blob: rule id, service metadata and the suggested operator action.
  context        String?

  @@index([status, service])
  @@index([timestamp])
}

/// Immutable trail of operator actions against the platform.
model AuditLog {
  id          String   @id @default(uuid())
  action      String
  performedBy String
  details     String
  timestamp   DateTime @default(now())

  @@index([timestamp])
}
