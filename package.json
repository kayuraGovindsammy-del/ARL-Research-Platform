    "recharts": "2.12.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "aedes": "0.51.2",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.6",
